rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio main document and configuration
    match /portfolio/{docId} {
      allow read, write: if true;
    }

    // Recruiter inquiries submitted from portfolio
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Real-time visitor logs and profile interaction events
    match /visitor_logs/{logId} {
      allow read, write: if true;
    }

    // Real-time active visitor presence heartbeats
    match /active_sessions/{sessionId} {
      allow read, write: if true;
    }
  }
}
